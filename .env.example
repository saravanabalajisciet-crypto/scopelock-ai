PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
GEMINI_API_KEY=your_gemini_api_key

# Production deployment configuration
FRONTEND_URL=https://your-app.vercel.app
BACKEND_PUBLIC_URL=https://your-api.onrender.com

# Persistent database location (configure a persistent disk)
DATABASE_PATH=/var/data/scopelock_orders.db

# Optional: override PayPal callback URLs
# PAYPAL_RETURN_URL=https://your-api.onrender.com/paypal/return
# PAYPAL_CANCEL_URL=https://your-api.onrender.com/paypal/cancel
